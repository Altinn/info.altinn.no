{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cache-infoportal",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-03",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"workers_dev": false,
	"env": {
		"at22": {
			"name": "cache-infoportal-at22",
			"services": [
				{
					"binding": "ASTRO_INFOPORTAL",
					"service": "astro-infoportal-at22"
				},
				{
					// Fallback mode: serves the site from the R2 snapshot (see snapshot-infoportal/FALLBACK.md).
					"binding": "SNAPSHOT_INFOPORTAL",
					"service": "snapshot-infoportal-at22"
				}
			],
			// fallback:mode is read from here. The secret FALLBACK_PREVIEW_TOKEN is set with:
			//   pnpm wrangler secret put FALLBACK_PREVIEW_TOKEN --env at22
			"kv_namespaces": [
				{
					// infoportal-fallback-at22 (same namespace as snapshot-infoportal-at22)
					"binding": "FALLBACK_KV",
					"id": "0edfe96c8cad4d7f8b4408d7f4120667"
				}
			]
		},
		"at23": {
			"name": "cache-infoportal-at23",
			"services": [
				{
					"binding": "ASTRO_INFOPORTAL",
					"service": "astro-infoportal-at23"
				}
			]
		},
		"tt02": {
			"name": "cache-infoportal-tt02",
			"services": [
				{
					"binding": "ASTRO_INFOPORTAL",
					"service": "astro-infoportal-tt02"
				}
			]
		},
		"prod": {
			"name": "cache-infoportal-prod",
			"services": [
				{
					"binding": "ASTRO_INFOPORTAL",
					"service": "astro-infoportal-prod"
				}
			]
		}	
	}	
}