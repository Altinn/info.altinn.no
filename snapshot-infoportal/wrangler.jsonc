{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "snapshot-infoportal",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-03",
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,

	// The top level is only used for local development and tests (wrangler dev / vitest).
	// R2, KV and Workflows are simulated locally by Miniflare.
	// Bindings are not inherited by environments, so each env below repeats them.
	"vars": {
		"SITE_ORIGIN": "http://localhost:4321",
		"BATCH_SIZE": "50",
		"CONCURRENCY": "6",
		"KEEP_SNAPSHOTS": "3",
		"MIN_SUCCESS_RATIO": "0.98"
	},
	"r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "infoportal-snapshots-local" }],
	"kv_namespaces": [{ "binding": "FALLBACK_KV", "id": "local" }],
	"workflows": [{ "name": "snapshot-infoportal-local", "binding": "SNAPSHOT_WORKFLOW", "class_name": "SnapshotWorkflow" }],

	"env": {
		"at22": {
			"name": "snapshot-infoportal-at22",
			// Nightly run is off while the PoC is tested with manual runs (wrangler workflows trigger).
			// To enable: "triggers": { "crons": ["0 2 * * *"] }   (02:00 UTC = 03:00/04:00 Norwegian time)
			"triggers": { "crons": [] },
			"vars": {
				// Public hostname in at22 (Umbraco__CMS__WebRouting__UmbracoApplicationUrl in syncroot/at22).
				"SITE_ORIGIN": "https://info.at22.altinn.cloud",
				"BATCH_SIZE": "50",
				"CONCURRENCY": "6",
				"KEEP_SNAPSHOTS": "3",
				"MIN_SUCCESS_RATIO": "0.98"
			},
			"services": [{ "binding": "ASTRO_INFOPORTAL", "service": "astro-infoportal-at22" }],
			"r2_buckets": [{ "binding": "SNAPSHOTS", "bucket_name": "infoportal-snapshots-at22", "jurisdiction": "eu" }],
			// infoportal-fallback-at22. The same namespace must be bound in cache-infoportal-at22.
			"kv_namespaces": [{ "binding": "FALLBACK_KV", "id": "0edfe96c8cad4d7f8b4408d7f4120667" }],
			"workflows": [{ "name": "snapshot-infoportal-at22", "binding": "SNAPSHOT_WORKFLOW", "class_name": "SnapshotWorkflow" }]
		}
		// at23, tt02 and prod are added in the same way once the PoC works in at22.
	}
}
